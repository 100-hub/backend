{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hub",
			"database_id": "ce0f8103-d8b8-4e11-8d30-5ff9bfe7fae2",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "hub",
			"binding": "HUB_BUCKET",
			"remote": true
		}
	]
